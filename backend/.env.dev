DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

#Limite de chamadas para as API
DRF_THROTTLE_ANON_RATE=1000/hour
DRF_THROTTLE_USER_RATE=1000/hour

#logs
LOG_LEVEL=ERROR
DJANGO_LOG_LEVEL=ERROR
DJANGO_REQUEST_LOG_LEVEL=ERROR
VENDAS_LOG_LEVEL=INFO

#logs de CRUD
LOG_FILE=logs/app.log

#executar testes automaticamente
RUN_TESTS_ON_STARTUP=True

#log de teste
TEST_DEBUG=False
TEST_LOG_FILE=logs/test_logs_file.log 

#banco de dados
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3

#carga inicial no banco
LOAD_INITIAL_DATA=True
SEED_TOTAL_CLIENTES=5
SEED_TOTAL_VENDEDORES=2
SEED_TOTAL_PRODUTOS=6
SEED_TOTAL_VENDAS=10
SEED_ITENS_POR_VENDA=2
SEED_BATCH_SIZE=100 #tamanho dos lotes usados na hora de inserir muitos registros no banco.

#Usuário padrão
DEFAULT_SUPERUSER_USERNAME=admin
DEFAULT_SUPERUSER_EMAIL=admin@email.com
DEFAULT_SUPERUSER_PASSWORD=admin

#Tamho da página retornada pelas API do sistema
PAGE_SIZE = 10